# ---- Required ----
# Public base URL of this app (used in emails and share links). No trailing slash.
APP_URL=http://localhost:3000
# Postgres connection string, e.g. postgres://USER:PASSWORD@127.0.0.1:5432/learnbay_navigator
DATABASE_URL=
# Random secret (48+ chars) used to sign sessions and hash codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Google Gemini API key (model: gemini-2.5-flash)
GEMINI_API_KEY=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to learners, e.g. "Learnbay Career Navigator <no-reply@learnbay.co>"
SMTP_FROM=

# ---- Optional ----
# Extra admin accounts (comma-separated) besides admissions@learnbay.co. Each sets its own password at /admin/login.
ADMIN_EMAILS=
# AI cost estimate in the admin token report (Gemini 2.5 Flash list price, USD per 1M tokens) and exchange rate
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
INR_PER_USD=88
# Days of analytics events to keep
ANALYTICS_RETENTION_DAYS=400
# Email automation: replies go here (use a mailbox someone reads)
EMAIL_REPLY_TO=
# Minimum hours between nurture emails to the same learner, and max emails sent per minute
EMAIL_MIN_GAP_HOURS=20
EMAIL_MAX_PER_TICK=40
# Serverless hosts: set EMAIL_WORKER=off and call POST /api/cron/emails every minute with this secret (16+ characters)
EMAIL_WORKER=
CRON_SECRET=
# Where "Talk to a Counselor" requests are emailed
COUNSELLOR_NOTIFY_EMAIL=
# Set to true when Postgres requires SSL (most managed databases)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# AI voice assistant for the mobile call button (either or both). Leave empty until the voice bot is live.
VOICE_ASSISTANT_URL=
VOICE_ASSISTANT_PHONE=
# Optional: an AI voice provider's webhook (https) that places an outbound call when a learner taps "Call me".
# It receives JSON { name, phone, counsellor, profile } with "Authorization: Bearer <CALL_TRIGGER_SECRET>".
CALL_TRIGGER_URL=
CALL_TRIGGER_SECRET=
# Development only: LAN hostnames/IPs allowed to open the dev server (e.g. 192.168.1.27)
DEV_ALLOWED_ORIGINS=
# ---- Scale & testing ----
# Max simultaneous Gemini calls per server instance (queue beyond this). Match your Gemini quota.
GEMINI_MAX_CONCURRENCY=40
# Postgres connections per server instance (use the Neon *pooler* URL when running several instances)
DB_POOL_MAX=20
# true = print emails to the log instead of sending (staging / load tests only)
MAIL_LOG_ONLY=false

# Prototype demo data: starting ratings for each counsellor, blended with real reviews. Set to false before real learners use the app.
DEMO_RATINGS=true

# Sales CRM connection (optional; leave empty until the company CRM is connected). See src/lib/crm/connector.ts.
# CRM_LOOKUP_URL: https endpoint asked "who owns this lead?" on every new lead. CRM_WEBHOOK_URL: receives lead events.
CRM_LOOKUP_URL=
CRM_WEBHOOK_URL=
CRM_API_KEY=

# Google Meet links (optional). A Google Workspace service account with domain-wide delegation for the scope
# https://www.googleapis.com/auth/calendar.events. Without it, each expert's own Meet room (CRM -> Team -> My profile) is used.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_MEET_ORGANIZER=
